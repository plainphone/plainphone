# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Where parents open the app (used in mails and pairing QR codes).
PUBLIC_URL=https://plainphone.example.org
# none = send no mail (sign-in then needs a mail provider). smtp needs SMTP_URL.
MAIL_PROVIDER=none
MAIL_FROM=Plainphone <no-reply@example.org>
# smtps://user:password@smtp.example.org:465
SMTP_URL=
# mock = no DNS filter service; http = the Plainphone DNS service (dns/).
DNS_PROVIDER=mock
DNS_API_URL=
DNS_API_TOKEN=
DNS_HOST_SUFFIX=dns.example.org
APP_PORT=8080
# true only when a reverse proxy sits in front and port 8080 is not public.
TRUST_PROXY=false
# New households per UTC day. Empty or 0 = no cap (the self-hosting default). Existing accounts
# and invited parents are never stopped (docs/self-hosting.md).
SIGNUP_DAILY_CAP=
# Bot and spam protection (docs/operations.md#bot-and-spam-protection). The dashboard and the app
# solve a short proof-of-work puzzle (ALTCHA, no third party) before a login link is mailed:
# altcha | off. Off by default. Parent-app builds from before the challenge cannot sign in while it
# is on, so the hosted service switches it on once the new app is the one in the stores.
BOT_CHALLENGE=
# Largest number in the puzzle; the average work is half of it. Default 100000.
BOT_CHALLENGE_DIFFICULTY=
# HMAC key for the puzzles, at least 32 characters. Empty: the server makes one and keeps it in the database.
BOT_CHALLENGE_HMAC_KEY=
# A hidden form field only bots fill in (on | off, default on).
SPAM_HONEYPOT=
# Refuse throwaway mail addresses for new households (on | off, default on).
BLOCK_DISPOSABLE_EMAIL=
# Invitation mails per household per 24 hours. Default 20; 0 = no cap.
INVITES_PER_HOUSEHOLD_DAILY=
# Optional: "Protect against reset" with the parent's Google account (docs/self-hosting.md).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Setup QR codes from the dashboard. Leave empty to use the project's released app
# (signed with the project's key). With your own build of the app, set both:
APK_DOWNLOAD_URL=
APK_METADATA_URL=
APK_SIGNATURE_CHECKSUM=

# Optional push delivery. See docs/push-setup.md before enabling.
PUSH_PROVIDER=none
PUSH_EXTRA_HOSTS=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
# Defaults to org.plainphone.app. Override for a custom iOS bundle ID.
APNS_BUNDLE_ID=
APNS_SANDBOX=false
# App links: the apps that open this server's login, pairing and invite links (docs/parent-app.md).
# Leave empty for the defaults: P7698GU4AV.org.plainphone.app and org.plainphone.parent.
# Android app links verify only once ANDROID_APP_CERT_SHA256 holds the signing certificate
# fingerprints (comma-separated).
APPLE_APP_IDS=
ANDROID_APP_PACKAGE=
ANDROID_APP_CERT_SHA256=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
