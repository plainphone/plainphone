{
  "name": "plainphone",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.21.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "dev:server": "pnpm --filter @plainphone/server dev",
    "dev:web": "pnpm --filter @plainphone/web dev",
    "site:screenshots": "NODE_PATH=${PLAYWRIGHT_NODE_PATH:-${NODE_PATH:-$HOME/dev/pw-test/node_modules}} node site/tools/site-screenshots.mjs"
  }
}
