# Copy to .env and fill in. Never commit .env.

# The DoT hostname. Phones use <ClientID>.<PPDNS_DOMAIN> as private DNS.
PPDNS_DOMAIN=dns.example.org

# Cloudflare API token with Zone:DNS:Edit on the zone that holds PPDNS_DOMAIN (for the certificate).
CLOUDFLARE_DNS_API_TOKEN=
# Optional contact address for Let's Encrypt.
LEGO_EMAIL=
# Use https://acme-staging-v02.api.letsencrypt.org/directory while testing.
LEGO_SERVER=https://acme-v02.api.letsencrypt.org/directory

# AdGuard Home admin login. The hash is only used on first boot. Keep it in
# single quotes, or Compose eats the parts after each "$":
#   htpasswd -nbBC 10 "" 'your-password' | cut -d: -f2
#   PPDNS_ADGUARD_PASSWORD_HASH='$2y$10$...'

PPDNS_ADGUARD_USER=admin
PPDNS_ADGUARD_PASSWORD=
PPDNS_ADGUARD_PASSWORD_HASH=

# Bearer token for the ppdns API (openssl rand -hex 32).
PPDNS_API_TOKEN=

# Where the admin UI and the API are published on the host. Use a private
# address (for example your Tailscale IP). 127.0.0.1 means "only this host".
PPDNS_ADMIN_BIND=127.0.0.1
PPDNS_API_BIND=127.0.0.1

# Optional: Uptime Kuma push URL. ppdns pushes its DoT self-test result every 5 minutes.
PPDNS_KUMA_PUSH_URL=

# Backups of AdGuardHome.yaml (all ClientIDs and rules): daily, kept in the data
# volume, and uploaded to S3-compatible storage when the bucket is set.
PPDNS_BACKUP_KEEP=14
PPDNS_BACKUP_S3_ENDPOINT=
PPDNS_BACKUP_S3_REGION=us-east-1
PPDNS_BACKUP_S3_BUCKET=
PPDNS_BACKUP_S3_PREFIX=plainphone-dns/
PPDNS_BACKUP_S3_ACCESS_KEY=
PPDNS_BACKUP_S3_SECRET_KEY=
